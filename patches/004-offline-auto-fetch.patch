+void EnsureOfflineLibraries::reportMissingFiles(const QStringList& missing)
+{
     emit logLine("Missing libraries:", MessageLevel::Error);
     for (const auto& jar : missing) {
         emit logLine("  " + jar, MessageLevel::Error);
@@ -51,3 +51,72 @@ void EnsureOfflineLibraries::executeTask()
                  MessageLevel::Fatal);
     emitFailed("Required libraries are missing");
 }
+
+void EnsureOfflineLibraries::executeTask()
+{
+    const QStringList missing = findMissingFiles();
+    if (missing.isEmpty()) {
+        emitSucceeded();
+        return;
+    }
+
+    // PATCH (personal build): the stock offline path stops here with the
+    // missing-file report below. When launching with a list whose every
+    // account is an offline account, download what is missing first, using
+    // the same public update steps an online launch runs, and then verify
+    // the result the stock way.
+    if (!m_fetchMissing) {
+        reportMissingFiles(missing);
+        return;
+    }
+
+    emit logLine(tr("Some game files are missing. Downloading them with the regular install steps, then the launch continues."),
+                 MessageLevel::Launcher);
+    m_fetchQueue = m_instance->createUpdateTask();
+    startNextFetch();
+}
+
+void EnsureOfflineLibraries::startNextFetch()
+{
+    m_currentFetch = nullptr;
+    if (m_fetchIndex >= m_fetchQueue.size()) {
+        verifyAfterFetch();
+        return;
+    }
+
+    m_currentFetch = m_fetchQueue.at(m_fetchIndex++);
+    propagateFromOther(m_currentFetch.get());
+    connect(m_currentFetch.get(), &Task::succeeded, this, [this] { startNextFetch(); });
+    connect(m_currentFetch.get(), &Task::failed, this, [this](QString reason) {
+        m_currentFetch = nullptr;
+        emitFailed(reason);
+    });
+    connect(m_currentFetch.get(), &Task::aborted, this, [this] {
+        m_currentFetch = nullptr;
+        emitAborted();
+    });
+    m_currentFetch->start();
+}
+
+void EnsureOfflineLibraries::verifyAfterFetch()
+{
+    const QStringList missing = findMissingFiles();
+    if (missing.isEmpty()) {
+        emitSucceeded();
+        return;
+    }
+    reportMissingFiles(missing);
+}
+
+bool EnsureOfflineLibraries::canAbort() const
+{
+    return m_currentFetch && m_currentFetch->canAbort();
+}
+
+bool EnsureOfflineLibraries::abort()
+{
+    if (m_currentFetch && m_currentFetch->canAbort()) {
+        return m_currentFetch->abort();
+    }
+    return false;
+}
